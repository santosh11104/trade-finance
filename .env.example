# API and database environment variables
PORT=4000
JWT_SECRET=supersecretkey
JWT_EXPIRES_IN=1h
DATABASE_URL=postgres://postgres:postgres@postgres:5432/tradefinance
FABRIC_WALLET_PATH=wallet
FABRIC_CONNECTION_PROFILE=../blockchain-api/config/connection-profile.json
FABRIC_CHANNEL_NAME=tradechannel
FABRIC_CHAINCODE_NAME=lccontract
FABRIC_CHAINCODE_LABEL=lccontract_1
FABRIC_USER_ID=appUser
FABRIC_ORG_MSP=Org1MSP
FABRIC_DISCOVERY_ENABLED=true
FABRIC_DISCOVERY_AS_LOCALHOST=true

# OpenTelemetry Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=tradefinance-api

# Network Credentials (Docker Compose)
FABRIC_CA_ADMIN=admin
FABRIC_CA_ADMIN_PW=adminpw

COUCHDB_USER=admin
COUCHDB_PASSWORD=adminpw

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tradefinance

EXPLORER_DB_USER=hppoc
EXPLORER_DB_PASSWORD=password
EXPLORER_DB_NAME=fabricexplorer

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
